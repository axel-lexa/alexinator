# Copier ce fichier sous le nom ".env" puis adapter les valeurs.
# N'importe quelle API compatible OpenAI convient.

# --- Modèle local avec Ollama (par défaut) ---
ALEXINATOR_BASE_URL=http://localhost:11434/v1
ALEXINATOR_API_KEY=ollama
ALEXINATOR_MODEL=llama3.1:8b

# Modèle des défenses (détecteur, censeur). Par défaut : le même que le gardien.
# ALEXINATOR_AUX_MODEL=llama3.1:8b

# --- Exemple avec un fournisseur en ligne ---
# ALEXINATOR_BASE_URL=https://adresse-de-l-api/v1
# ALEXINATOR_API_KEY=votre_cle
# ALEXINATOR_MODEL=nom-du-modele

# --- Fabrication du jeu de données d'entraînement ---
# Modèle « professeur » qui écrit les réponses idéales (par défaut : ALEXINATOR_MODEL).
# ALEXINATOR_TEACHER_MODEL=nom-du-meilleur-modele-disponible

# --- TMDB (The Movie Database) : pour compléter data/films.json ---
# « API Key » ou « API Read Access Token » de https://www.themoviedb.org/settings/api (compte gratuit).
# Tester : python -m alexinator.tmdb --test
# ALEXINATOR_TMDB_TOKEN=eyJhbGciOi...

# --- Jouer avec NOTRE modèle entraîné, chargé directement sur le GPU (sans serveur) ---
# ALEXINATOR_BACKEND=local
# ALEXINATOR_MODEL=Qwen/Qwen2.5-7B-Instruct
# ALEXINATOR_ADAPTER=finetune/gardien-lora
